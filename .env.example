# ── Clerk (auth) ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Supabase (entitlements + downloads) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (TTPN Pty Ltd, test mode) ──────────────────────────────────────────
# Both flags default off. /api/checkout and /api/stripe/webhook return 503
# unless STRIPE_ENABLED is exactly "true". NEXT_PUBLIC_STRIPE_ENABLED is
# baked in at build time and only controls the Buy button.
STRIPE_ENABLED=false
NEXT_PUBLIC_STRIPE_ENABLED=false
# TTPN test secret (sk_test_…). Never commit a real value.
STRIPE_SECRET_KEY=
# Signing secret for this site's test webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Lookup-key prefix and Checkout metadata.site.
STRIPE_SITE_KEY=tradiedocs
# Not used by Prebuilt Checkout. Leave blank unless a client Stripe.js flow is added.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Mailchimp (direct-submit popup — action URL goes in waitlist-popup.tsx) ───
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SITE_TAG=

# ── Resend (transactional email) ──────────────────────────────────────────────
RESEND_API_KEY=
# Verified sender on your domain. Leave blank until that sender exists.
RESEND_FROM=
RESEND_REPLY_TO=
NOTIFY_EMAIL=

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=
SITE_KEY=
# Footer, legal pages, and llms.txt. Leave blank to show no address.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Canonical domain for sitemap + OG tags (no protocol). Falls back to Vercel URL, then site.config domain.
NEXT_PUBLIC_SITE_DOMAIN=
# Show GitHub link in footer (set "true" to show; unset/false hides it)
NEXT_PUBLIC_SHOW_GITHUB_FOOTER=
